@import url('https://fonts.googleapis.com/css2?family=Bungee&family=Inter:wght@400;500;600;700;800;900&display=swap');

:root {
  --bg: #05070b;
  --panel: #0e141a;
  --panel-strong: #101b23;
  --panel-soft: #162630;
  --card: rgba(12, 18, 25, 0.86);
  --red: #f44336;
  --red-deep: #c12d28;
  --pink: #ff7b7b;
  --white: #eef5f7;
  --muted: #b8c7ce;
  --line: rgba(255, 255, 255, 0.08);
  --green: #38d39f;
  --orange: #ffb454;
  --purple: #c597ff;
  --shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top, rgba(255, 104, 104, 0.12), transparent 30%),
    linear-gradient(180deg, #010305 0%, #091019 100%);
  color: var(--white);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
  border: none;
}

img {
  max-width: 100%;
  display: block;
}

.page-shell {
  min-height: 100vh;
}

.container {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 24px 0 10px;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 16px;
  min-width: 220px;
}

.brand-mark {
  width: 58px;
  height: 58px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff625b, #d3181b);
  box-shadow: 0 12px 30px rgba(248, 71, 71, 0.3);
  font-family: 'Bungee', cursive;
  color: var(--white);
  font-size: 2.2rem;
}

.brand-word {
  font-family: 'Bungee', cursive;
  font-size: clamp(1.5rem, 2vw, 2.2rem);
  letter-spacing: 0.02em;
  color: var(--red);
  text-shadow: 0 4px 24px rgba(255, 96, 96, 0.4);
}

.brand-tag {
  font-size: 0.74rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.7);
}

.main-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  color: rgba(255, 255, 255, 0.75);
  flex-wrap: wrap;
}

.main-nav a {
  transition: color 0.2s ease;
}

.main-nav a:hover {
  color: var(--white);
}

.primary-btn,
.ghost-btn {
  border-radius: 999px;
  padding: 0.9rem 1.5rem;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--red), var(--red-deep));
  color: var(--white);
  box-shadow: 0 12px 28px rgba(240, 53, 48, 0.35);
}

.primary-btn:hover,
.ghost-btn:hover {
  transform: translateY(-1px);
}

.primary-btn.small {
  padding: 0.72rem 1.2rem;
  font-size: 0.9rem;
}

.ghost-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--line);
  color: var(--white);
}

.hero {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  align-items: center;
  gap: 30px;
  padding: 28px 0 36px;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--pink);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 0.72rem;
  font-weight: 700;
}

.hero-title {
  margin: 0;
  font-size: clamp(5rem, 12vw, 16rem);
  line-height: 0.8;
  font-family: 'Bungee', cursive;
  color: var(--red);
  text-shadow: 0 10px 34px rgba(255, 89, 89, 0.25);
}

.hero-subtitle {
  margin: -10px 0 16px;
  font-size: clamp(2.2rem, 4vw, 4rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  color: rgba(255, 255, 255, 0.9);
}

.hero-text {
  margin: 0;
  max-width: 600px;
  color: var(--muted);
  font-size: 1.08rem;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.hero-stats {
  margin-top: 30px;
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 120px;
}

.hero-stats strong {
  font-size: 1.7rem;
  font-weight: 800;
}

.hero-stats span {
  color: var(--muted);
  font-size: 0.82rem;
}

.hero-panel {
  display: flex;
  justify-content: center;
}

.glass-card {
  width: 100%;
  max-width: 430px;
  background: linear-gradient(180deg, rgba(16, 27, 35, 0.85), rgba(18, 28, 38, 0.95));
  border: 1px solid var(--line);
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.service-card {
  padding: 26px;
}

.card-topline {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.pulse-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 10px rgba(56, 211, 159, 0.9);
}

.mini-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 22px;
}

.mini-metrics div {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 18px 16px;
}

.mini-metrics span {
  display: block;
  color: var(--muted);
  font-size: 0.72rem;
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.mini-metrics strong {
  font-size: 2.1rem;
}

.timeline {
  display: grid;
  gap: 12px;
  margin-top: 24px;
}

.timeline-item {
  display: flex;
  align-items: center;
  gap: 14px;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 14px;
  border: 1px solid var(--line);
  padding: 14px 12px;
}

.timeline-item span {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  color: var(--white);
  font-weight: 700;
}

.timeline-item.active span {
  background: linear-gradient(135deg, var(--red), var(--red-deep));
}

.timeline-item p {
  margin: 0;
  color: var(--muted);
  line-height: 1.5;
}

.section {
  padding: 52px 0;
}

.alt-bg {
  background: rgba(255, 255, 255, 0.02);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.section-heading {
  margin-bottom: 28px;
}

.section-heading h3 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.04em;
}

.left {
  max-width: 650px;
}

.restaurant-layout {
  display: grid;
  grid-template-columns: 1.45fr 0.75fr;
  gap: 26px;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.menu-card,
.event-card,
.academy-card,
.portal-card,
.payment-card,
.admin-card,
.tracking-card,
.qr-box {
  background: rgba(13, 19, 25, 0.8);
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: var(--shadow);
}

.menu-card {
  padding: 20px;
}

.menu-badge {
  display: inline-block;
  background: rgba(244, 67, 54, 0.14);
  color: var(--pink);
  padding: 0.42rem 0.72rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  margin-bottom: 16px;
}

.menu-card h4,
.event-card h4,
.academy-card h4,
.portal-card h4 {
  margin: 0 0 10px;
  font-size: 1.35rem;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: var(--muted);
  font-size: 0.82rem;
  padding-bottom: 14px;
}

.menu-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--line);
}

.menu-footer strong {
  font-size: 1.25rem;
}

.menu-footer button,
.chat-input-row button,
.portfolio-btn {
  background: linear-gradient(135deg, var(--red), var(--red-deep));
  color: white;
  border-radius: 12px;
  padding: 0.8rem 1rem;
  font-weight: 700;
}

.cart-panel {
  background: rgba(10, 16, 21, 0.88);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 22px;
  height: fit-content;
}

.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.cart-header h4 {
  margin: 0;
  font-size: 1.5rem;
}

.cart-header span {
  color: var(--muted);
  font-size: 0.8rem;
}

.empty-state {
  color: var(--muted);
  line-height: 1.7;
  padding: 18px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.cart-items {
  display: grid;
  gap: 12px;
}

.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 12px;
  border: 1px solid var(--line);
  padding: 12px;
}

.cart-item strong,
.cart-item small {
  display: block;
}

.cart-item small {
  color: var(--muted);
  margin-top: 4px;
}

.cart-item button {
  background: transparent;
  color: var(--pink);
}

.totals {
  margin-top: 22px;
  display: grid;
  gap: 10px;
  padding-top: 12px;
  border-top: 1px solid var(--line);
}

.totals div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: var(--muted);
}

.grand-total {
  margin-top: 8px;
  padding-top: 12px;
  border-top: 1px dashed var(--line);
  color: var(--white) !important;
}

.full-width {
  width: 100%;
}

.event-grid,
.academy-grid,
.admin-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.event-card,
.academy-card,
.admin-card {
  padding: 22px;
}

.event-icon {
  width: 52px;
  height: 52px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-size: 1.5rem;
  background: rgba(244, 67, 54, 0.1);
  color: var(--pink);
  margin-bottom: 18px;
}

.event-card p {
  color: var(--muted);
  line-height: 1.7;
}

.event-card strong {
  display: block;
  margin: 18px 0;
  font-size: 1.8rem;
}

.academy-level {
  display: inline-block;
  background: rgba(197, 151, 255, 0.12);
  color: var(--purple);
  border-radius: 999px;
  padding: 0.45rem 0.72rem;
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.portal-grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 22px;
  margin-top: 34px;
}

.portal-card {
  padding: 22px;
}

.portal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.status-pill {
  background: rgba(56, 211, 159, 0.12);
  color: var(--green);
  padding: 0.42rem 0.7rem;
  border-radius: 999px;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.status-pill.purple {
  background: rgba(197, 151, 255, 0.14);
  color: var(--purple);
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.avatar {
  width: 54px;
  height: 54px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  font-weight: 800;
  background: linear-gradient(135deg, rgba(255, 116, 116, 0.22), rgba(255, 255, 255, 0.06));
  color: var(--white);
}

.profile-row strong,
.profile-row small {
  display: block;
}

.profile-row small {
  color: var(--muted);
}

.portal-list {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  line-height: 1.9;
}

.ai-panel {
  min-height: 100%;
}

.chat-box {
  display: grid;
  gap: 10px;
  max-height: 270px;
  overflow: auto;
  margin-bottom: 18px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
  padding: 16px;
  border-radius: 16px;
}

.chat-bubble {
  max-width: 85%;
  padding: 0.8rem 1rem;
  border-radius: 16px;
  line-height: 1.6;
}

.chat-bubble.bot {
  background: rgba(255, 255, 255, 0.04);
  color: var(--white);
}

.chat-bubble.user {
  background: linear-gradient(135deg, rgba(255, 93, 93, 0.18), rgba(255, 153, 153, 0.06));
  margin-left: auto;
  color: var(--white);
}

.chat-input-row {
  display: flex;
  gap: 12px;
}

.chat-input-row input {
  flex: 1;
  border-radius: 12px;
  padding: 0.85rem 1rem;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.02);
  color: var(--white);
}

.tracking-layout {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 24px;
  align-items: center;
}

.tracking-card {
  padding: 22px;
}

.tracking-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 20px;
}

.tracking-info span {
  color: var(--muted);
}

.tracking-info strong {
  font-size: 1.3rem;
}

.tracking-bar {
  width: 100%;
  height: 12px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 999px;
  overflow: hidden;
}

.tracking-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--red), var(--pink));
  border-radius: 999px;
}

.tracking-status-row {
  margin-top: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-size: 0.8rem;
}

.qr-box {
  padding: 28px 22px;
  display: grid;
  place-items: center;
  gap: 18px;
}

.qr-code {
  width: 220px;
  height: 220px;
  background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.02) 100%);
  border: 1px solid var(--line);
  border-radius: 18px;
  position: relative;
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 4px;
  padding: 18px;
}

.qr-code span {
  display: block;
  background: rgba(255,255,255,0.85);
  border-radius: 4px;
}

.qr-code span:nth-child(odd) {
  opacity: 0.2;
}

.qr-code span:nth-child(3n) {
  opacity: 0.8;
}

.qr-meta {
  text-align: center;
}

.qr-meta strong {
  display: block;
  font-size: 1.2rem;
  margin-bottom: 8px;
}

.qr-meta p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.payment-layout {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 22px;
}

.payment-card {
  padding: 24px;
}

.payment-options {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.payment-options button {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--white);
  padding: 0.7rem 1rem;
  font-weight: 700;
}

.payment-options .selected {
  background: rgba(255, 85, 85, 0.14);
  color: var(--pink);
  border-color: rgba(255, 124, 124, 0.25);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

label {
  display: grid;
  gap: 8px;
  color: var(--muted);
  font-size: 0.82rem;
}

.form-grid input {
  width: 100%;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.02);
  color: var(--white);
  padding: 0.9rem 1rem;
}

.full-span {
  grid-column: 1 / -1;
}

.checkout-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
}

.accent-card {
  background: linear-gradient(180deg, rgba(255, 91, 91, 0.12), rgba(18, 28, 38, 0.82));
}

.accent-card h4 {
  margin: 0 0 18px;
  font-size: 2.5rem;
}

.accent-card ul {
  margin: 0 0 20px;
  padding-left: 18px;
  color: var(--muted);
  line-height: 1.9;
}

.small-space {
  margin: 0 0 10px;
}

.admin-card {
  position: relative;
  overflow: hidden;
}

.admin-card::before {
  content: '';
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, var(--red), transparent);
}

.admin-card span,
.admin-card em {
  display: block;
  color: var(--muted);
}

.admin-card strong {
  display: block;
  margin: 16px 0 12px;
  font-size: 2rem;
}

.admin-table-wrap {
  margin-top: 28px;
  overflow: auto;
  background: rgba(12, 18, 25, 0.8);
  border: 1px solid var(--line);
  border-radius: 22px;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  text-align: left;
  padding: 16px 18px;
  border-bottom: 1px solid var(--line);
}

th {
  color: var(--muted);
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

tbody tr:last-child td {
  border-bottom: none;
}

.status-pill.green {
  background: rgba(56, 211, 159, 0.1);
  color: var(--green);
}

.status-pill.orange {
  background: rgba(255, 180, 84, 0.12);
  color: var(--orange);
}

.status-pill.blue {
  background: rgba(122, 172, 255, 0.12);
  color: #8ab4ff;
}

.site-footer {
  padding: 26px 0 52px;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
}

.brand-word.mini {
  font-size: 1.6rem;
}

.site-footer p {
  margin: 8px 0 0;
  color: var(--muted);
}

.footer-links {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  color: var(--muted);
}

@media (max-width: 980px) {
  .hero,
  .restaurant-layout,
  .tracking-layout,
  .payment-layout,
  .portal-grid {
    grid-template-columns: 1fr;
  }

  .event-grid,
  .academy-grid,
  .admin-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .main-nav {
    justify-content: flex-start;
  }

  .menu-grid,
  .event-grid,
  .academy-grid,
  .admin-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .hero-title {
    font-size: 4.5rem;
  }

  .brand-word {
    font-size: 1.2rem;
  }
}
